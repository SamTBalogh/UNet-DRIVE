# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Logs
*.log
logs/

# Test and coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local datasets and generated data (keep directory placeholders)
data/raw/**
!data/raw/.gitadd
data/processed/**
!data/processed/.gitadd

# Training outputs and generated artifacts (keep public structure)
outputs/**
!outputs/figures/
!outputs/figures/.gitadd
!outputs/models/
!outputs/models/.gitadd
!outputs/results/
!outputs/results/.gitadd
!outputs/segmentations/
!outputs/segmentations/.gitadd
runs/
wandb/
mlruns/

# Model files generated by training
*.keras
*.h5
*.hdf5
*.ckpt
*.weights.h5

# Generated arrays and intermediate artifacts
*.npy
*.npz
*.pkl
*.pickle

# Compressed datasets or delivery packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Local documentation drafts
docs/
report/
presentation/
